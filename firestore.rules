rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Public test document for boot connection verification
    match /test/{docId} {
      allow read: if true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User profile validation
    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'displayName']) &&
             data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() <= 100;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && incoming().userId == existing().userId;
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    // Admin account validation & credentials for operations tracking
    match /adminAccounts/{adminId} {
      allow read, write: if true;
    }

    // Cart Orders - accessible for live order placement and administrative order tracking
    match /cartOrders/{orderId} {
      allow read, write: if true;
    }

    // Soundbox tracks validation
    function isValidSoundboxTrack(data) {
      return data.keys().hasAll(['userId', 'title', 'audioType']) &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 120 &&
             data.audioType in ['lyria_clip', 'lyria_pro', 'soundbox_call', 'custom_tts'];
    }

    match /soundboxTracks/{trackId} {
      allow get: if isSignedIn() && isValidId(trackId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(trackId) && isValidSoundboxTrack(incoming());
      allow update: if isSignedIn() && isValidId(trackId) && isValidSoundboxTrack(incoming()) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isValidId(trackId) && resource.data.userId == request.auth.uid;
    }

    // AI Consultations validation
    function isValidAiConsultation(data) {
      return data.keys().hasAll(['userId', 'city', 'recommendation']) &&
             data.userId == request.auth.uid &&
             data.city is string && data.city.size() <= 80 &&
             data.recommendation is string;
    }

    match /aiConsultations/{consultationId} {
      allow get: if isSignedIn() && isValidId(consultationId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(consultationId) && isValidAiConsultation(incoming());
      allow delete: if isSignedIn() && isValidId(consultationId) && resource.data.userId == request.auth.uid;
    }
  }
}
